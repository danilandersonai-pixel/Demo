# === Telegram ===
# Токен бота от @BotFather
BOT_TOKEN=123456:ABC-DEF...

# Telegram ID двух пользователей, которым разрешён доступ (через запятую).
# Узнать свой ID можно у бота @userinfobot
ALLOWED_USER_IDS=111111111,222222222

# === Хранилище ===
# Путь к файлу базы данных SQLite
DB_PATH=data/finance.db
# Каталог для сохранения фото чеков
RECEIPTS_DIR=data/receipts

# === Локаль ===
# Валюта для отображения
CURRENCY=₽
# Часовой пояс (IANA), например Europe/Moscow
TZ=Europe/Moscow

# === OCR ===
# Языки Tesseract для распознавания чеков
OCR_LANG=rus+eng
