# === Telegram ===
# Токен бота от @BotFather
BOT_TOKEN=123456:ABC-DEF...

# Telegram ID двух пользователей, которым разрешён доступ (через запятую).
# Узнать свой ID можно у бота @userinfobot
ALLOWED_USER_IDS=111111111,222222222

# === Хранилище ===
# Путь к файлу базы данных SQLite
DB_PATH=data/finance.db
# Каталог для сохранения фото чеков
RECEIPTS_DIR=data/receipts

# === Локаль ===
# Валюта для отображения
CURRENCY=₽
# Часовой пояс (IANA), например Europe/Moscow
TZ=Europe/Moscow

# === OCR ===
# Языки Tesseract для распознавания чеков (фолбэк, если AI выключен)
OCR_LANG=rus+eng

# === AI (OpenRouter) — опционально ===
# Ключ с https://openrouter.ai/keys (sk-or-v1-...). Если пусто — AI выключен,
# бот работает на Tesseract + правилах.
OPENROUTER_API_KEY=
# Модель для текста и vision (по умолчанию дешёвая Gemini Flash).
OPENROUTER_MODEL=google/gemini-2.0-flash-001
# Отдельная vision-модель (если не задана — используется OPENROUTER_MODEL).
OPENROUTER_VISION_MODEL=
